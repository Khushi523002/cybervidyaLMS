{
  "info": {
    "_postman_id": "6af98413-4dc0-4fd4-8a12-6e1ea7ac5473",
    "name": "Cybervidya LMS API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collection for onboarding, login, dashboard, and approval workflows."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000" },
    { "key": "adminEmail", "value": "admin@cybervidya.com" },
    { "key": "adminPassword", "value": "Admin@12345" },
    { "key": "managerEmail", "value": "manager@cybervidya.com" },
    { "key": "managerPassword", "value": "Manager@12345" },
    { "key": "internEmail", "value": "intern1@cybervidya.com" },
    { "key": "adminToken", "value": "" },
    { "key": "managerToken", "value": "" },
    { "key": "internToken", "value": "" },
    { "key": "internUserId", "value": "1" },
    { "key": "internId", "value": "INT-1001" },
    { "key": "approvalId", "value": "1" },
    { "key": "reviewId", "value": "1" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login/"
          }
        },
        {
          "name": "Manager Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{managerEmail}}\",\n  \"password\": \"{{managerPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login/"
          }
        },
        {
          "name": "Intern Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{internEmail}}\",\n  \"password\": \"TEMP_PASSWORD_FROM_GENERATE_PASSWORD_API\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login/"
          }
        },
        {
          "name": "Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{managerToken}}" }],
            "url": "{{baseUrl}}/api/auth/profile/"
          }
        },
        {
          "name": "User Profile Detail",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{managerToken}}" }],
            "url": "{{baseUrl}}/api/auth/users/{{internUserId}}/profile/"
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{internToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"TEMP_PASSWORD_FROM_GENERATE_PASSWORD_API\",\n  \"new_password\": \"Intern@12345\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/change-password/"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{managerToken}}" }],
            "url": "{{baseUrl}}/api/auth/logout/"
          }
        }
      ]
    },
    {
      "name": "Onboarding",
      "item": [
        {
          "name": "Create Intern",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{managerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Aarav Intern\",\n  \"education\": \"B.Tech Computer Science\",\n  \"certification\": \"Python Fundamentals\",\n  \"contact_no\": \"+91-9876543210\",\n  \"email\": \"{{internEmail}}\",\n  \"intern_id\": \"INT-1001\"\n}"
            },
            "url": "{{baseUrl}}/api/onboarding/interns/"
          }
        },
        {
          "name": "List Interns",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{managerToken}}" }],
            "url": "{{baseUrl}}/api/onboarding/interns/"
          }
        },
        {
          "name": "Intern Detail",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{managerToken}}" }],
            "url": "{{baseUrl}}/api/onboarding/interns/{{internUserId}}/"
          }
        },
        {
          "name": "Update Intern",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{managerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"certification\": \"Advanced Python\",\n  \"contact_no\": \"+91-9000000000\"\n}"
            },
            "url": "{{baseUrl}}/api/onboarding/interns/{{internUserId}}/"
          }
        },
        {
          "name": "Generate Temporary Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{managerToken}}" }],
            "url": "{{baseUrl}}/api/onboarding/interns/{{internUserId}}/generate-password/"
          }
        },
        {
          "name": "Delete Intern",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{managerToken}}" }],
            "url": "{{baseUrl}}/api/onboarding/interns/{{internUserId}}/"
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Dashboard Overview As Admin",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/dashboard/overview/"
          }
        },
        {
          "name": "Dashboard Overview As Manager",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{managerToken}}" }],
            "url": "{{baseUrl}}/api/dashboard/overview/"
          }
        },
        {
          "name": "Dashboard Overview As Intern",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{internToken}}" }],
            "url": "{{baseUrl}}/api/dashboard/overview/"
          }
        },
        {
          "name": "Intern Dashboard List",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{managerToken}}" }],
            "url": "{{baseUrl}}/api/dashboard/interns/"
          }
        },
        {
          "name": "Admin Filter Interns By Rating",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/dashboard/interns/?min_review_rating=4&max_review_rating=5"
          }
        }
      ]
    },
    {
      "name": "Approvals",
      "item": [
        {
          "name": "Intern Create Edit Approval",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{internToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"request_type\": \"edit\",\n  \"reason\": \"Need to update my certification details.\"\n}"
            },
            "url": "{{baseUrl}}/api/approvals/"
          }
        },
        {
          "name": "Intern Create Delete Approval",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{internToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"request_type\": \"delete\",\n  \"reason\": \"Need delete access for my own record.\"\n}"
            },
            "url": "{{baseUrl}}/api/approvals/"
          }
        },
        {
          "name": "List Approvals As Manager",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{managerToken}}" }],
            "url": "{{baseUrl}}/api/approvals/"
          }
        },
        {
          "name": "List Approvals As Intern",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{internToken}}" }],
            "url": "{{baseUrl}}/api/approvals/"
          }
        },
        {
          "name": "Review Approval",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{managerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\",\n  \"review_notes\": \"Approved by manager.\"\n}"
            },
            "url": "{{baseUrl}}/api/approvals/{{approvalId}}/review/"
          }
        }
      ]
    },
    {
      "name": "Reviews",
      "item": [
        {
          "name": "Save Communication Review",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{managerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"intern_user_id\": {{internUserId}},\n  \"intern_id\": \"{{internId}}\",\n  \"communication_rating\": 4,\n  \"communication_comment\": \"Good communication and timely updates.\"\n}"
            },
            "url": "{{baseUrl}}/api/reviews/communication/"
          }
        },
        {
          "name": "Save Technical Review",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{managerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"intern_user_id\": {{internUserId}},\n  \"intern_id\": \"{{internId}}\",\n  \"technical_rating\": 5,\n  \"technical_comment\": \"Strong technical execution.\"\n}"
            },
            "url": "{{baseUrl}}/api/reviews/technical/"
          }
        },
        {
          "name": "Create Combined Review",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{managerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"intern_user_id\": {{internUserId}},\n  \"communication_rating\": 4,\n  \"communication_comment\": \"Good communication and timely updates.\",\n  \"technical_rating\": 5,\n  \"technical_comment\": \"Strong technical execution.\"\n}"
            },
            "url": "{{baseUrl}}/api/reviews/"
          }
        },
        {
          "name": "List Reviews As Manager",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{managerToken}}" }],
            "url": "{{baseUrl}}/api/reviews/"
          }
        },
        {
          "name": "List Reviews As Intern",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{internToken}}" }],
            "url": "{{baseUrl}}/api/reviews/"
          }
        },
        {
          "name": "List Reviews As Admin With Filter",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/reviews/?min_average_rating=4"
          }
        },
        {
          "name": "Review Detail",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{managerToken}}" }],
            "url": "{{baseUrl}}/api/reviews/{{reviewId}}/"
          }
        },
        {
          "name": "Update Communication Review",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{managerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"communication_rating\": 5,\n  \"communication_comment\": \"Improved communication over the last week.\"\n}"
            },
            "url": "{{baseUrl}}/api/reviews/{{reviewId}}/communication/"
          }
        },
        {
          "name": "Update Technical Review",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{managerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"technical_rating\": 4,\n  \"technical_comment\": \"Needs a bit more refinement in edge cases.\"\n}"
            },
            "url": "{{baseUrl}}/api/reviews/{{reviewId}}/technical/"
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "List Notifications",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{internToken}}" }],
            "url": "{{baseUrl}}/api/notifications/"
          }
        },
        {
          "name": "List Unread Notifications",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{internToken}}" }],
            "url": "{{baseUrl}}/api/notifications/?unread_only=true"
          }
        },
        {
          "name": "Mark Notification Read",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{internToken}}" }],
            "url": "{{baseUrl}}/api/notifications/1/read/"
          }
        },
        {
          "name": "Mark All Notifications Read",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{internToken}}" }],
            "url": "{{baseUrl}}/api/notifications/read-all/"
          }
        }
      ]
    }
  ]
}
